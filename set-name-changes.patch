+// Where the name starts in the line of names.txt for `key` (capitals or not, as file names are on
+// Windows, the Switch's SD card and a phone's storage; spaces before the '=' allowed), or 0 when
+// the line is another game's.
+inline size_t NameAt(const std::string& line, const std::string& key)
+{
+    if (key.empty() || line.size() <= key.size() || Upper(line.substr(0, key.size())) != Upper(key)) return 0;
+    size_t i = key.size();
+    while (i < line.size() && line[i] == ' ') i++;
+    return i < line.size() && line[i] == '=' ? i + 1 : 0;
+}
+
+inline std::vector<std::string> ReadLines(const std::string& path)
+{
+    std::vector<std::string> lines;
+    if (FILE* f = fopen(path.c_str(), "r"))
+    {
+        char buf[2048];
+        while (fgets(buf, sizeof buf, f))
+        {
+            std::string l = buf;
+            while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+            // (A UTF-8 byte order mark, from a text editor on Windows.)
+            if (lines.empty() && l.compare(0, 3, "\xEF\xBB\xBF") == 0) l = l.substr(3);
+            lines.push_back(l);
+        }
+        fclose(f);
+    }
+    return lines;
+}
