+// The game "--game <arg>" names: a ROM's path or file name, else a game code (the first ROM of
+// that game, as before there were names), capitals or not; -1 for none that `usable` allows.
+template <class Usable>
+inline int FindGame(const std::vector<Game>& games, const std::string& arg, Usable usable)
+{
+    const std::string a = Upper(arg), file = Upper(FileName(arg));
+    for (int pass = 0; pass < 3 && !a.empty(); pass++)
+        for (size_t i = 0; i < games.size(); i++)
+        {
+            const Game& g = games[i];
+            if (g.comingSoon || !usable(g)) continue;
+            if (pass == 0 ? Upper(g.rom) == a : pass == 1 ? Upper(FileName(g.rom)) == file : Upper(g.code) == a) return (int)i;
+        }
+    return -1;
+}
