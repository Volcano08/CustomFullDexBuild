+inline bool CopyFileAs(const std::string& from, const std::string& to)
+{
+    FILE* in = fopen(from.c_str(), "rb");
+    if (!in) return false;
+    const std::string tmp = to + ".tmp";
+    FILE* out = fopen(tmp.c_str(), "wb");
+    bool ok = out != nullptr;
+    char buf[65536];
+    size_t n;
+    while (ok && (n = fread(buf, 1, sizeof buf, in)) > 0) ok = fwrite(buf, 1, n, out) == n;
+    ok = ok && !ferror(in);
+    fclose(in);
+    if (out) ok = fclose(out) == 0 && ok;
+    // (`to` is not there, so a plain rename does: Windows and the Switch rename onto no file.)
+    ok = ok && rename(tmp.c_str(), to.c_str()) == 0;
+    if (!ok) remove(tmp.c_str());
