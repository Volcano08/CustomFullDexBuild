+// What names the game there: its game code (IREO) when it is the only ROM of its game in the
+// list, else its ROM's file name ("Heartfelt Gold.nds"), which tells it from the game's others;
+// or, when another of them has that file name too (in another folder), its whole path.
+inline std::string GameArg(const std::vector<Game>& games, const Game& g)
+{
+    bool others = false;
+    for (const Game& o : games)
+        if (&o != &g && !o.comingSoon && o.platform == g.platform && o.code == g.code && o.rom != g.rom)
+        {
+            if (Upper(FileName(o.rom)) == Upper(FileName(g.rom))) return g.rom;
+            others = true;
+        }
+    return others ? FileName(g.rom) : g.code;
