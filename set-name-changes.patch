+inline std::string ListText(const std::string& utf8)
+{
+    // (Latin-1's letters U+00C0 to U+00FF as plain ones; '*': not a letter, left out.)
+    static const char latin[] = "AAAAAAACEEEEIIIIDNOOOOO*OUUUUYPSAAAAAAACEEEEIIIIDNOOOOO*OUUUUYPY";
+    std::string out;
+    for (size_t i = 0; i < utf8.size();)
+    {
+        const unsigned char c = (unsigned char)utf8[i];
+        const int n = c < 0x80 ? 1 : (c & 0xE0) == 0xC0 ? 2 : (c & 0xF0) == 0xE0 ? 3 : (c & 0xF8) == 0xF0 ? 4 : 0;
+        if (n == 0 || i + n > utf8.size())
+        {
+            i++;
+            continue;
+        }
+        uint32_t cp = n == 1 ? c : c & (0x7F >> n);
+        for (int k = 1; k < n; k++) cp = cp << 6 | ((unsigned char)utf8[i + k] & 0x3F);
+        i += n;
+        if (cp < 0x20 || cp == 0x7F) continue;
+        if (cp < 0x80) out += (char)toupper((int)cp);
+        else if (cp == 0xC9 || cp == 0xE9) out += '\x05';
