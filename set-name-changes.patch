+        if (g.comingSoon || g.platform != chosen.platform || g.code != chosen.code || SaveFolder(g) != dir) continue;
+        if (Upper(g.saveName) == Upper(g.legacySave)) inUse = true;
+        else if (std::find_if(heirs.begin(), heirs.end(), [&](const Game* h) { return Upper(h->saveName) == Upper(g.saveName); }) == heirs.end())
+            heirs.push_back(&g);
