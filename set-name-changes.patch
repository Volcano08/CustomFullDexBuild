+
+// The names in names.txt given to the games it has a line for.
+inline void ApplyNames(std::vector<Game>& games, const std::string& listFolder)
+{
+    const std::vector<std::string> lines = ReadLines(NamesFile(listFolder));
+    if (lines.empty()) return;
+    for (Game& g : games)
+    {
+        if (g.comingSoon) continue;
+        const std::string key = NameKey(g, listFolder);
+        for (const std::string& l : lines)
