+// RENAME (X in the game list): the console's own keyboard (a library applet) for the game's name
+// in the list, starting from the name it has, the ROM's file name (and its save) under it. False
+// when it was closed without OK; an empty name gives the game its own again.
+bool AskName(const Launcher::Game& g, std::string& name)
+{
+    SwkbdConfig kbd;
+    if (R_FAILED(swkbdCreate(&kbd, 0))) return false;
+    swkbdConfigMakePresetDefault(&kbd);
+    // (Shown on a line, with the header and sub text: at most 32 characters for that.)
+    swkbdConfigSetTextDrawType(&kbd, SwkbdTextDrawType_Line);
+    swkbdConfigSetStringLenMax(&kbd, Launcher::NameMax);
+    swkbdConfigSetHeaderText(&kbd, "Name in the game list");
+    const std::string sub = Launcher::FileName(g.rom) + (g.platform == Launcher::DS && g.known ? "   (save: " + g.saveName + ")" : "");
+    swkbdConfigSetSubText(&kbd, sub.c_str());
+    swkbdConfigSetGuideText(&kbd, "Leave empty to reset the name");
+    swkbdConfigSetOkButtonText(&kbd, "Rename");
+    const std::string start = Launcher::Utf8Cut(Launcher::DisplayName(g), Launcher::NameMax);
+    swkbdConfigSetInitialText(&kbd, start.c_str());
+    char out[256] = {};
+    const Result rc = swkbdShow(&kbd, out, sizeof out);
+    swkbdClose(&kbd);
+    fprintf(stderr, "[switch] rename %s: %s\n", g.rom.c_str(), R_SUCCEEDED(rc) ? out : "cancelled");
+    if (R_FAILED(rc)) return false;
+    name = out;
+    return true;
+}
