+            continue;
+        }
+        fprintf(stderr, "[launcher] save: %s handed on to %s\n", chosen.legacySave.c_str(), g->saveName.c_str());
+        if (heirs.size() == 1 && !inUse && FileExists(shared + ".state") && !FileExists(own + ".state") &&
