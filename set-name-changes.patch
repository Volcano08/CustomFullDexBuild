+            const std::string bak = file + (k == 1 ? std::string(".bak") : ".bak" + std::to_string(k));
+            if (FileExists(bak)) continue;
+            if (rename(file.c_str(), bak.c_str()) == 0) fprintf(stderr, "[launcher] save: the shared one kept as %s\n", bak.c_str());
+            break;
+        }
+    }
