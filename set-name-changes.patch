+// The player's name for a game kept in names.txt (empty, or the game's own name: its line taken
+// out), the other lines as they were. False if the file could not be written.
+inline bool StoreName(const std::string& listFolder, const Game& g, const std::string& name)
+{
+    const std::string key = NameKey(g, listFolder), clean = Utf8Cut(CleanName(name), NameMax);
+    std::vector<std::string> lines;
+    for (const std::string& l : ReadLines(NamesFile(listFolder)))
+        if (!NameAt(l, key) && !l.empty()) lines.push_back(l);
+    if (!clean.empty() && clean != OwnDisplayName(g)) lines.push_back(key + "=" + clean);
+    FILE* f = fopen(NamesFile(listFolder).c_str(), "w");
+    if (!f) return false;
+    bool ok = true;
+    for (const std::string& l : lines) ok = fprintf(f, "%s\n", l.c_str()) >= 0 && ok;
+    return fclose(f) == 0 && ok;
